# Образ проекта. python:3.11-slim выбран как компромисс: официальный, без лишних
# пакетов (образ вчетверо легче полного), но с рабочим apt на случай, если
# зависимостям понадобится сборка.
FROM python:3.11-slim

# Логи Python должны идти в поток НЕМЕДЛЕННО: без этой переменной вывод
# буферизуется, и при падении контейнера последние строки просто теряются —
# то есть самое интересное.
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

# Зависимости ставятся ОТДЕЛЬНЫМ слоем до копирования кода: правка исходников
# не заставляет Docker переустанавливать библиотеки заново.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

EXPOSE 8000

# --reload осознанно не включён: он для разработки, в контейнере лишний
# сторожевой процесс и лишняя память.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
