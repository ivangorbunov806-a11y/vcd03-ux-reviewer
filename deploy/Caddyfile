# Caddy — вход снаружи и TLS.
#
# Почему Caddy, а не nginx + certbot: сертификат он получает и продлевает сам,
# без отдельного таймера и без правки конфига. Для одного сервиса это разница
# между «настроил и забыл» и «через 90 дней сертификат протух».
#
# ⚠️ Домен записан в punycode. Кириллическое имя пишется в сертификат именно
# так, и на этом легко ошибиться: строку автопилот24.рф руками не преобразуешь,
# её надо получать кодированием (python: "имя".encode("idna")).

ux.xn--24-6kci4astcg2af.xn--p1ai {
	# Сервис слушает только петлю — снаружи в него нет прямого хода.
	reverse_proxy 127.0.0.1:8000 {
		# Передаём настоящий адрес обратившегося, чтобы ограничение частоты
		# считало по нему, а не по адресу самого Caddy. Работает в паре с
		# TRUST_PROXY=true в .env: без этой пары заголовок либо подделают,
		# либо все запросы сольются в один счётчик.
		header_up X-Forwarded-For {remote_host}
	}

	# Тело запроса у нас — это адрес страницы и пара флагов. Мегабайты сюда
	# слать незачем, а вот заваливать сервис большими телами — обычный приём.
	request_body {
		max_size 16KB
	}

	header {
		# Просим браузеры ходить сюда только по https в течение года.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		# Убираем подпись сервера: чем меньше известно о начинке, тем меньше
		# смысла перебирать известные уязвимости именно этой версии.
		-Server
	}

	log {
		output file /var/log/caddy/ux-reviewer.log {
			roll_size 10MB
			roll_keep 5
		}
	}
}
