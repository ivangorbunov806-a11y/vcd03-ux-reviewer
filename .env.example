# Скопируйте этот файл в .env и заполните.
# ⚠️ .env в git НЕ попадает (см. .gitignore) — секреты хранятся только на машине.

# --- Модель --------------------------------------------------------------
# Ключ provod.ai (личный кабинет → API-ключи)
API_KEY=

# Базовый адрес провайдера. provod.ai OpenAI-совместим, поэтому работает
# официальная библиотека openai. Переход на другого совместимого провайдера —
# правка этой строки, кода он не касается.
BASE_URL=https://api.provod.ai/v1

# Модель. gpt-5.4-mini — дешёвая и достаточная для разбора текста.
# ⚠️ Ветка openai/gpt-5.4* не принимает temperature — учтено в коде
# (ux_reviewer/llm_client.py, таблица MODEL_QUIRKS).
MODEL=openai/gpt-5.4-mini

# --- Доступ к веб-сервису ------------------------------------------------
# Сервис работает как открытое демо: разбор доступен всем, но под общим
# суточным потолком. Токен — это ключ ВЛАДЕЛЬЦА: он обходит суточный потолок,
# чтобы в исчерпанный день хозяин мог пользоваться сервисом.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_TOKEN=

# ⭐ ПОТОЛОК РАСХОДОВ. Сколько разборов в сутки разрешено ВСЕМ гостям вместе.
# Один разбор ≈ 1 ₽, поэтому это число примерно равно рублям в худший день.
# Лимит на адрес от общего расхода НЕ защищает: адресов у ботов много.
DAILY_LIMIT=100

# Сколько разборов разрешено с одного адреса в час — против одного шумного
# посетителя. Общий потолок задаётся отдельно, переменной выше.
RATE_LIMIT_PER_HOUR=20

# Источники, которым разрешено обращаться из браузера (через запятую).
# Пусто = никому: сервис вызывается скриптами с токеном, а не чужими страницами.
ALLOWED_ORIGINS=

# Ставить true ТОЛЬКО когда перед сервисом стоит наш обратный прокси. Иначе
# любой подставит X-Forwarded-For и обнулит себе счётчик запросов.
TRUST_PROXY=false

# --- Журнал --------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
