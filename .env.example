# Скопируйте этот файл в .env и впишите свой ключ.
# ⚠️ .env в git НЕ попадает (см. .gitignore) — ключ хранится только на машине.

# Ключ provod.ai (личный кабинет → API-ключи)
API_KEY=

# Базовый адрес провайдера. provod.ai OpenAI-совместим, поэтому работает
# официальная библиотека openai. Для перехода на другого совместимого
# провайдера достаточно поменять эту строку.
BASE_URL=https://api.provod.ai/v1

# Модель. gpt-5.4-mini — дешёвая и достаточная для разбора текста.
# ⚠️ Ветка openai/gpt-5.4* не принимает temperature — это учтено в коде
# (ux_reviewer/llm_client.py, таблица MODEL_QUIRKS).
MODEL=openai/gpt-5.4-mini

# Уровень журналирования: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
